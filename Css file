*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    line-height:1.6;
    color:#333;
    background:#fff;
}

/* ===========================
   Navigation
=========================== */

header{
    background:#0077b6;
    position:sticky;
    top:0;
}

.navbar{
    max-width:1200px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:1rem 2rem;
}

.navbar h1{
    color:white;
}

.navbar ul{
    list-style:none;
    display:flex;
    gap:20px;
}

.navbar a{
    text-decoration:none;
    color:white;
    transition:.3s;
}

.navbar a:hover{
    color:#90e0ef;
}

/* ===========================
   Hero
=========================== */

.hero{
    background-image:url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=1400");
    background-size:cover;
    background-position:center;
    color:white;
    text-align:center;
    padding:7rem 2rem;
}

.hero h2{
    font-size:3rem;
    margin-bottom:20px;
}

.hero p{
    max-width:700px;
    margin:auto;
    margin-bottom:30px;
    font-size:1.1rem;
}

.button{
    display:inline-block;
    background:#0077b6;
    color:white;
    text-decoration:none;
    padding:14px 28px;
    border-radius:8px;
    transition:.3s;
}

.button:hover{
    background:#005b8f;
    transform:scale(1.05);
}

/* ===========================
   Gallery
=========================== */

.gallery{
    display:flex;
    justify-content:center;
    gap:20px;
    padding:60px 20px;
}

.gallery img{
    width:45%;
    border-radius:10px;
    box-shadow:0 5px 15px rgba(0,0,0,.2);
}

/* ===========================
   About
=========================== */

.about{
    text-align:center;
    padding:60px 20px;
}

.about h2{
    margin-bottom:40px;
}

.about-cards{
    display:flex;
    justify-content:center;
    gap:20px;
}

/* ===========================
   Cards
=========================== */

.card{
    background:white;
    width:300px;
    padding:25px;
    border-radius:10px;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
}

.card h3{
    margin-bottom:15px;
}

/* ===========================
   Features
=========================== */

.features{
    display:flex;
    justify-content:center;
    gap:20px;
    padding:60px 20px;
}

/* ===========================
   Testimonials
=========================== */

.testimonials{
    background:#caf0f8;
    text-align:center;
    padding:60px 20px;
}

.testimonials h2{
    margin-bottom:40px;
}

.testimonial-container{
    display:flex;
    justify-content:center;
    gap:20px;
}

.testimonial{
    background:white;
    width:280px;
    padding:20px;
    border-radius:10px;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
}

.testimonial h4{
    margin-top:15px;
}

/* ===========================
   Footer
=========================== */

footer{
    background:#222;
    color:white;
    display:flex;
    justify-content:space-around;
    flex-wrap:wrap;
    padding:40px 20px;
}

.footer-links{
    display:flex;
    flex-direction:column;
    margin:15px;
}

.footer-links a{
    color:white;
    text-decoration:none;
    margin:5px 0;
    transition:.3s;
}

.footer-links a:hover{
    color:#90e0ef;
}

.footer-map iframe{
    width:280px;
    height:180px;
    border:none;
    border-radius:10px;
}

/* ===========================
   Responsive
=========================== */

@media (max-width:768px){

.navbar{
    flex-direction:column;
}

.navbar ul{
    flex-direction:column;
    text-align:center;
    margin-top:20px;
}

.hero h2{
    font-size:2rem;
}

.gallery{
    flex-direction:column;
    align-items:center;
}

.gallery img{
    width:100%;
}

.about-cards{
    flex-direction:column;
    align-items:center;
}

.features{
    flex-direction:column;
    align-items:center;
}

.testimonial-container{
    flex-direction:column;
    align-items:center;
}

footer{
    flex-direction:column;
    text-align:center;
}

.footer-map iframe{
    width:100%;
    margin-top:20px;
}

}
